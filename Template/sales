</head>

<body>

<div class="container-fluid p-4">

<!-- TOP BAR -->
<div class="topbar d-flex justify-content-between align-items-center">
    <h3>Akshaya Billing - Sales Entry</h3>
    <a href="/dashboard/" class="btn btn-light">← Back</a>
</div>

<!-- STAFF + DATE -->
<div class="card p-3 mt-3 shadow">
<div class="row">

<div class="col-md-4">
<label>Staff Name</label>
<select class="form-control" id="staff">
    {% for s in staffs %}
        <option value="{{ s.id }}">{{ s.username }}</option>
    {% endfor %}
</select>
</div>

<div class="col-md-4">
<label>Date</label>
<input type="date" class="form-control" value="{{ today_date }}">
</div>

</div>
</div>

<!-- SEARCH -->
<div class="card p-3 mt-3 shadow">
<input type="text" class="form-control"
       placeholder="Search Service..."
       onkeyup="filterServices(this.value)">
</div>

<!-- SERVICE TABLE -->
<div class="card p-3 mt-3 shadow">

<table class="table table-bordered text-center">

<thead class="table-dark">
<tr>
<th>Service</th>
<th>Rate</th>
<th>Qty</th>
<th>Total</th>
</tr>
</thead>

<tbody id="serviceBody">

<tr>
<td>
<select class="form-control service-select" onchange="serviceChanged(this)">
<option value="">-- Select Service --</option>
{% for p in products %}
<option value="{{ p.id }}" data-rate="{{ p.rate }}">
{{ p.name }}
</option>
{% endfor %}
</select>
</td>

<td class="rate">0</td>

<td>
<input type="number" class="form-control qty" value="1"
       oninput="calculateRow(this)">
</td>

<td>
<input type="text" class="form-control amount" readonly>
</td>

</tr>

</tbody>

</table>

<!-- ADD ROW BUTTON -->
<div class="text-end mt-2">
<button class="btn btn-primary" onclick="addRow()">+ Add Service</button>
</div>

</div>

<!-- GRAND TOTAL -->
<div class="card p-4 mt-3 text-center bg-success text-white">
<h4>Grand Total</h4>
<h2>₹ <span id="grandtotal">0</span></h2>
</div>

<!-- SAVE -->
<div class="text-end mt-3">
<button class="btn btn-success btn-lg" onclick="saveBill()">Save Bill</button>
</div>

</div>

<script>

function serviceChanged(select) {
    let rate = select.options[select.selectedIndex].dataset.rate || 0;
    let row = select.closest("tr");
    row.querySelector(".rate").innerText = rate;
    calculateRow(row.querySelector(".qty"));
}

function calculateRow(qtyInput) {
    let row = qtyInput.closest("tr");
    let rate = parseFloat(row.querySelector(".rate").innerText || 0);
    let qty = parseFloat(qtyInput.value || 0);
    row.querySelector(".amount").value = rate * qty;
    calculateGrand();
}

function calculateGrand() {
    let grand = 0;
    document.querySelectorAll(".amount").forEach(a => {
        grand += parseFloat(a.value || 0);
    });
    document.getElementById("grandtotal").innerText = grand;
}

function filterServices(text) {
    text = text.toLowerCase();
    document.querySelectorAll(".service-select option").forEach(opt => {
        if (opt.value === "") return;
        opt.style.display = opt.text.toLowerCase().includes(text) ? "" : "none";
    });
}

function addRow() {

    let table = document.getElementById("serviceBody");

    let newRow = document.createElement("tr");

    newRow.innerHTML = `
        <td>
            <select class="form-control service-select" onchange="serviceChanged(this)">
                <option value="">-- Select Service --</option>
                {% for p in products %}
                <option value="{{ p.id }}" data-rate="{{ p.rate }}">
                    {{ p.name }}
                </option>
                {% endfor %}
            </select>
        </td>

        <td class="rate">0</td>

        <td>
            <input type="number" class="form-control qty" value="1"
                   oninput="calculateRow(this)">
        </td>

        <td>
            <input type="text" class="form-control amount" readonly>
        </td>
    `;

    table.appendChild(newRow);
}

function saveBill() {

    let items = [];

    document.querySelectorAll("#serviceBody tr").forEach(row => {

        let service = row.querySelector(".service-select").value;
        let qty = row.querySelector(".qty").value;
        let rate = row.querySelector(".rate").innerText;

        if (service && qty > 0) {
            items.push({
                product_id: service,
                qty: qty,
                rate: rate
            });
        }
    });

    let staffId = document.getElementById("staff").value;

    fetch("/save-bill/", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "X-CSRFToken": "{{ csrf_token }}"
        },
        body: JSON.stringify({
            items: items,
            staff_id: staffId
        })
    })
    .then(res => res.json())
    .then(data => {
        if (data.bill_id) {
            window.open(`/receipt/${data.bill_id}/`, "_blank");
        }
        location.reload();
    });
}

</script>

</body>
